# Go binary and build artifacts.
#
# Unanchored on purpose: each component keeps its own bin/ (apps/eye/bin/,
# and more to come), and a leading slash would only ignore one at the
# repository root.
bin/
*.out
*.test
coverage.out

# Environment secrets
.env

# Editor/OS noise
.DS_Store
.idea/
.vscode/

# Python (packages/eye-client, services/twin, apps/api)
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
