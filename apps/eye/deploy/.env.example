# eye — deployment environment.
#
#   cp deploy/.env.example deploy/.env
#
# .env is gitignored and must stay that way. Every variable here is read in
# internal/config and nowhere else.

# ── The API token ────────────────────────────────────────────────────────────
# Guards every /v1 endpoint. /health and / stay open, because a probe has no
# credential. `eye serve --public` refuses to start without this.
#
# Generate one:
#   openssl rand -base64 32
#   # or: head -c 32 /dev/urandom | base64
EYE_API_TOKEN=

# Where a browser application may call the API from. "*" is the default and is
# fine for a token-guarded read API; narrow it if you front eye with a page of
# your own.
# EYE_CORS_ORIGIN=*

# ── Paths ────────────────────────────────────────────────────────────────────
# Set by the image. Override only if you moved the volume.
# EYE_DATA_DIR=/var/lib/eye
# EYE_CONFIG_DIR=/etc/eye

# ── What to collect and retain (#125) ────────────────────────────────────────
# Optional. Restricts the registry (never widens it): an allow-list or
# deny-list of source ids, optionally by topic, plus a retention override per
# id. Missing entirely: today's behaviour, unchanged. See
# deploy/overrides.example.yaml and docker-compose.yml's bind mount comment.
# EYE_OVERRIDES_FILE=/etc/eye/overrides.yaml

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
EYE_LOG_LEVEL=info

# ── Undocumented personal sources (ADR-0008) ─────────────────────────────────
# Off by default, and deliberately not enough on its own: live bus arrivals are
# served only when this is set AND EYE_API_TOKEN is set, so the data cannot
# leave an authenticated deployment. Read docs/adr/0008 before turning it on.
# EYE_ALLOW_PERSONAL_SOURCES=0

# ── Source credentials ───────────────────────────────────────────────────────
# Free key from https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# Free key from https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=
