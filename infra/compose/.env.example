# infra/compose/.env — the mvp stack's environment.
#
#   cp .env.example .env    # then edit it — see infra/deployment/README.md
#
# .env is gitignored by the root .gitignore's unanchored ".env" rule and
# must stay that way: never commit it, never bake it into an image.

# eye's API token. Copy the exact value from eye's own host-side .env
# (apps/eye/deploy/.env on the VPS) — never print or commit it.
EYE_API_TOKEN=

# The name of eye's compose network, so twin and api can reach eye-api by
# service name. Matches eye's compose project name unless it was deployed
# under a different -p name.
EYE_NETWORK=cordvba-eye_default

# The public origin the edge answers at once Tailscale Funnel is pointed at
# EDGE_PORT below. Passed verbatim as the api's CORS allow-origin
# (WEB_ORIGIN, see apps/api/README.md), which also accepts a
# comma-separated list of origins now that the page is additionally
# published on GitHub Pages (issue #115), e.g.:
#   PUBLIC_ORIGIN=https://<machine>.<tailnet>.ts.net,https://www.fullfran.com
PUBLIC_ORIGIN=https://<machine>.<tailnet>.ts.net

# Loopback port the edge publishes. Tailscale Funnel forwards to this port;
# nothing else needs to reach it directly.
EDGE_PORT=8088
