# eye — local development environment
# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Every variable here is read in internal/config and nowhere else.

# ── Paths ────────────────────────────────────────────────────────────────────
# Store and raw cache. Defaults to $XDG_DATA_HOME/eye, else ~/.local/share/eye
# EYE_DATA_DIR=

# sources.yaml and rules.yaml. Defaults to $XDG_CONFIG_HOME/eye, else ~/.config/eye
# EYE_CONFIG_DIR=

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
EYE_LOG_LEVEL=info

# ── The HTTP API ─────────────────────────────────────────────────────────────
# Guards every /v1 endpoint of `eye serve`. /health and / stay open, because a
# probe has no credential. `eye serve --public` refuses to start without this.
# Generate one with: openssl rand -base64 32
# EYE_API_TOKEN=

# What Access-Control-Allow-Origin answers. Defaults to "*", which is fine for
# a token-guarded read API; narrow it if you front eye with a page of your own.
# EYE_CORS_ORIGIN=*

# ── TLS ──────────────────────────────────────────────────────────────────────
# A PEM file of certificate authorities to trust IN ADDITION to the system pool.
#
# Needed for servers that send an incomplete certificate chain. MITECO's
# air-quality host is the one in this registry: its certificate is valid and
# publicly rooted, but the FNMT-RCM intermediate is missing from the handshake,
# and Go does not fetch it the way a browser does. Supplying it completes the
# chain — this is not, and can never be, a way to skip verification.
#
#   curl -o /tmp/accomp.crt http://www.cert.fnmt.es/certs/ACCOMP.crt
#   openssl x509 -inform DER -in /tmp/accomp.crt -out ~/.config/eye/fnmt-intermediate.pem
#   EYE_EXTRA_CA_FILE=~/.config/eye/fnmt-intermediate.pem
# EYE_EXTRA_CA_FILE=

# ── Source credentials ───────────────────────────────────────────────────────
# Free key from https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# Free key from https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# OAuth2 client credentials. Only needed for the OpenSky provider, which is held
# on licence review for anything beyond personal use.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
